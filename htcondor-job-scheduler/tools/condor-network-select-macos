#!/bin/sh
# Decide whether this Mac should use the entry node's PRIVATE address.
#
# macOS port of condor-network-select. SAME decision, SAME output file, SAME
# fail-safe behaviour -- only the OS interfaces differ, so the two can be read
# side by side and any divergence is a bug in one of them.
#
# WHAT REPLACES WHAT
#   getent ahostsv4  ->  dscacheutil -q host      (no getent on macOS; the
#                        Directory Service cache answers mDNS the same
#                        per-interface way, which is the property this relies
#                        on: a machine's own .local name resolves to the
#                        address reachable from where you are asking)
#   /usr/bin paths   ->  /opt/condor/release/bin  (tarball install, and note
#                        that condor_status is in bin while condor_restart and
#                        the other admin tools are in sbin)
#
# THE CACHE FLUSH IS NOT OPTIONAL
# This runs precisely when addressing has just changed, which is exactly when
# the Directory Service cache still holds the previous answer. Deriving from a
# stale answer produces a confidently wrong result, which is worse than the
# failure this exists to prevent.
#
# Install: /usr/local/bin/condor-network-select (root, 0755)
# Invoked: by condor-network-change-macos, on address change and at boot

OUT=/opt/condor/etc/config.d/55-network-select.config
# NOT inside config.d: condor reads every file in that directory, so a
# half-written temp file there becomes live config for as long as it exists.
TMP=/opt/condor/etc/.55-network-select.$$
CB=/opt/condor/release/bin
CONDOR_CONFIG=/opt/condor/etc/condor_config
export CONDOR_CONFIG

: > "$TMP" 2>/dev/null || exit 0
trap 'rm -f "$TMP"' EXIT

finish() {
    mv -f "$TMP" "$OUT" 2>/dev/null      # atomic; condor never sees a partial file
    trap - EXIT
    exit 0
}

HOST=$("$CB/condor_config_val" CONDOR_HOST 2>/dev/null)
[ -n "$HOST" ] || finish

# A literal address cannot be resolved per-interface; nothing to derive.
case "$HOST" in
    *[!0-9.]*) ;;
    *) finish ;;
esac

dscacheutil -flushcache 2>/dev/null
killall -HUP mDNSResponder 2>/dev/null

# 1. Which address do WE reach the entry node on, from where we are now?
MINE=$(dscacheutil -q host -a name "$HOST" 2>/dev/null | awk '/^ip_address:/ { print $2; exit }')
[ -n "$MINE" ] || finish

# 2. What does the collector advertise? The sinful string carries the private
#    address URL-encoded:  PrivAddr=%3c192.168.0.123:9618%3f...&PrivNet=foo
#
#    This query does NOT depend on PRIVATE_NETWORK_NAME already being right:
#    COLLECTOR_HOST is a name, resolved fresh per-interface, so the tool dials
#    the collector directly rather than picking between advertised addresses.
#    That is what stops the derivation deadlocking on its own output.
AD=$("$CB/condor_status" -collector -af MyAddress 2>/dev/null | head -1)
[ -n "$AD" ] || finish

PRIV=$(printf '%s' "$AD" | sed -n 's/.*PrivAddr=%3c\([0-9.]*\):.*/\1/p')
NAME=$(printf '%s' "$AD" | sed -n 's/.*PrivNet=\([^&>]*\).*/\1/p')

# 3. Adopt the name only if the address we reached it on IS its private one.
if [ -n "$PRIV" ] && [ -n "$NAME" ] && [ "$MINE" = "$PRIV" ]; then
    {
        echo "# Generated by condor-network-select - do not edit."
        echo "# $(date '+%Y-%m-%d %H:%M:%S')"
        echo "# Reached ${HOST} on ${MINE}, which is the entry node's PrivAddr,"
        echo "# so this machine adopts its PrivNet name to be handed that address."
        echo "PRIVATE_NETWORK_NAME = ${NAME}"
    } > "$TMP"
else
    {
        echo "# Generated by condor-network-select - do not edit."
        echo "# $(date '+%Y-%m-%d %H:%M:%S')"
        echo "# Reached ${HOST} on ${MINE}; entry node PrivAddr is '${PRIV:-none}'."
        echo "# Not a match, so the primary address is used and no name is set."
    } > "$TMP"
fi

finish
